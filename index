        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f3f3f3; /* Color de fondo */
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }
        h1 {
            text-align: center;
            color: #333; /* Color del texto */
        }
        .video-thumbnails {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            margin-top: 20px;
        }
        .video-thumbnail {
            margin: 10px;
            position: relative;
            overflow: hidden;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); /* Sombra */
        }
        .video-thumbnail img {
            width: 100%; /* Ancho máximo */
            height: auto;
            transition: transform 0.3s ease; /* Efecto de transición */
        }
        .video-thumbnail:hover img {
            transform: scale(1.1); /* Efecto de zoom al pasar el ratón */
        }
        .play-button {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 50px;
            height: 50px;
            background-color: rgba(255, 255, 255, 0.8); /* Fondo del botón */
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: background-color 0.3s ease; /* Transición */
        }
        .play-button:hover {
            background-color: rgba(255, 255, 255, 0.9); /* Cambio de color al pasar el ratón */
        }
        .play-button img {
            width: 70%;
            height: auto;
            filter: brightness(0.8); /* Reducción del brillo */
        }
    </style>
